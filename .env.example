# Skopiuj ten plik do .env i uzupelnij wartosci. Nigdy nie commituj .env do gita.

# Lista linkow wyszukiwania Vinted (posortowanych od najnowszych), rozdzielonych przecinkiem.
# Bot sprawdza kazde z osobna, ale deduplikacja ofert jest wspolna (id sprawdzone raz).
VINTED_SEARCH_URLS=https://www.vinted.pl/catalog?search_text=pokemon%20psa&order=newest_first,https://www.vinted.pl/catalog?search_text=pokemon%20bgs&order=newest_first

# Klucz API z https://www.pokemonpricetracker.com (Account -> API Keys). Darmowy tier: 100 kredytow/dzien.
POKEMONPRICETRACKER_API_KEY=

# Discord webhook URL (Ustawienia kanalu -> Integracje -> Webhooki -> Nowy webhook -> Kopiuj URL)
DISCORD_WEBHOOK_URL=

# Zakres rabatu wzgledem ceny referencyjnej, w ktorym bot wysyla powiadomienie.
# Dodatnie wartosci = tansze niz cena referencyjna, ujemne = drozsze.
# Domyslnie: od 2% drozej do 40% taniej (powyzej 40% taniej to zwykle bledne dopasowanie karty).
MIN_DISCOUNT_PERCENT=-2
MAX_DISCOUNT_PERCENT=40

# Minimalna liczba sprzedazy w danym gradingu, zeby cena referencyjna byla uznana za wiarygodna
MIN_SALES_SAMPLE=3

# Ile najnowszych ofert z Vinted analizowac w kazdym przebiegu
MAX_LISTINGS_PER_RUN=50

# Ile ogloszen bez PSA w tytule dodatkowo sprawdzic przez pobranie opisu (per przebieg)
MAX_DESCRIPTION_FETCHES_PER_RUN=50
